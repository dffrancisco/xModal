{
  "name": "xmodalv2",
  "version": "3.0.2",
  "description": "Modal em JavaScript puro, sem dependências de runtime: botões, onOpen/onClose, atalhos de teclado, Esc, temas e redimensionamento.",
  "main": "xModal/xModal.mjs",
  "module": "xModal/xModal.mjs",
  "types": "xModal/index.d.ts",
  "exports": {
    ".": {
      "types": "./xModal/index.d.ts",
      "import": "./xModal/xModal.mjs",
      "default": "./xModal/xModal.mjs"
    },
    "./index.css": "./xModal/index.css",
    "./xModal.js": "./xModal/xModal.js",
    "./package.json": "./package.json"
  },
  "files": [
    "xModal"
  ],
  "scripts": {
    "build": "npm version patch && rimraf xModal && node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dffrancisco/xModal.git"
  },
  "keywords": [
    "modal",
    "dialog"
  ],
  "author": "Francisco Alves",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dffrancisco/xModal/issues"
  },
  "homepage": "https://github.com/dffrancisco/xModal#readme",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
